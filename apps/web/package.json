{
  "name": "@project-genesis/web",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js App Router UI (Architecture 1.1) — UI only, no business APIs",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm run test:unit",
    "test:unit": "jest --config test/jest.config.cjs --runInBand",
    "test:cov": "jest --config test/jest.config.cjs --coverage --runInBand",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true}); require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@project-genesis/sdk": "workspace:*",
    "@project-genesis/types": "workspace:*",
    "@project-genesis/shared": "workspace:*",
    "@tanstack/react-query": "^5.69.0",
    "next": "^15.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.12",
    "typescript": "^5.8.2"
  }
}
