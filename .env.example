# Application
NODE_ENV=development

# NestJS API (server) — required from M3
PORT=3001

# Observability — Epic 00 / M8 (placeholders; no vendor SDKs)
# LOG_LEVEL=info
# OTEL_ENABLED=false

# MongoDB / Redis — required from M5
# Host defaults for processes running on the machine (not inside Compose):
DATABASE_URL=mongodb://localhost:27017/project-genesis
REDIS_URL=redis://localhost:6379
#
# If using docker/docker-compose.infra.yml or docker/docker-compose.yml,
# Redis is published on host 6380 — use REDIS_URL=redis://localhost:6380 from the host.
# Inside Compose, services use mongodb://mongodb:27017/... and redis://redis:6379.

# Frontend (apps/web) — used from M4 onward
# Browser-facing URL (also a Docker build-arg for the web image).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Testing — Epic 00 / M9 (optional; integration skips cleanly when unset)
# No Docker/Testcontainers required for default unit/api/e2e.
# TEST_DATABASE_URL=mongodb://localhost:27017/project-genesis-test
# TEST_REDIS_URL=redis://localhost:6379/15

# Auth placeholders — used from Epic 01 onward (do not commit real secrets)
# JWT_SECRET=change-me-in-local-development
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# Optional provider selection — Epic 00 / M6 (placeholders only; no SDKs)
# AI_PROVIDER=not-implemented
# STORAGE_PROVIDER=not-implemented
# SEARCH_PROVIDER=not-implemented

# Optional provider secrets — unused until concrete providers are added
# AI_API_KEY=
# STORAGE_KEY=
# STORAGE_SECRET=
