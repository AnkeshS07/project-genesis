# Application
NODE_ENV=development

# NestJS API (server) — required from M3
PORT=3001

# MongoDB / Redis — required from M5
# Default ports assume local Mongo on 27017 and Redis on 6379.
# If using docker/docker-compose.infra.yml, Redis is published on host 6380.
DATABASE_URL=mongodb://localhost:27017/project-genesis
REDIS_URL=redis://localhost:6379

# Frontend (apps/web) — used from M4 onward
NEXT_PUBLIC_API_URL=http://localhost:3001

# Auth placeholders — used from Epic 01 onward (do not commit real secrets)
# JWT_SECRET=change-me-in-local-development
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# Optional provider placeholders — unused in Epic 00
# AI_API_KEY=
# STORAGE_KEY=
# STORAGE_SECRET=
