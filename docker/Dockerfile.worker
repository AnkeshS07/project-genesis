# syntax=docker/dockerfile:1

############################################
# NestJS Worker — multi-stage, pnpm workspace
# Same build artifact as API; different entrypoint.
############################################

ARG NODE_VERSION=20-alpine
ARG PNPM_VERSION=9.15.9

FROM node:${NODE_VERSION} AS base
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
WORKDIR /app

FROM base AS deps
ENV HUSKY=0
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY server/package.json ./server/
COPY packages/types/package.json ./packages/types/
COPY packages/shared/package.json ./packages/shared/
COPY packages/sdk/package.json ./packages/sdk/
COPY apps/web/package.json ./apps/web/
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
  pnpm install --frozen-lockfile --filter @project-genesis/server...

FROM deps AS build
COPY tsconfig.base.json ./
COPY server ./server
RUN pnpm --filter @project-genesis/server build \
  && pnpm --filter @project-genesis/server deploy --prod /deploy \
  && mkdir -p /deploy/dist \
  && cp -R /app/server/dist/. /deploy/dist/

FROM node:${NODE_VERSION} AS runner
ENV NODE_ENV=production
WORKDIR /app

RUN apk add --no-cache tini \
  && addgroup -S app && adduser -S app -G app \
  && chown -R app:app /app

COPY --from=build --chown=app:app /deploy/ ./

USER app
STOPSIGNAL SIGTERM

# No HTTP server — verify worker entry artifact is present (process supervision is Docker's job).
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "require('fs').accessSync('dist/worker.main.js'); process.exit(0)"

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/worker.main.js"]
