# Docker Compose environment example (Epic 00 / M10)
# Copy to docker/.env for local overrides (never commit secrets).
#
#   cp docker/.env.example docker/.env

# Host port mappings (dev compose)
MONGO_HOST_PORT=27017
REDIS_HOST_PORT=6380
API_HOST_PORT=3001
WEB_HOST_PORT=3000

# Browser-facing API URL baked into the web image at build time
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional image tags for production compose
# API_IMAGE=project-genesis-api:prod
# WORKER_IMAGE=project-genesis-worker:prod
# WEB_IMAGE=project-genesis-web:prod

# In-compose service URLs (defaults already set in compose files):
# DATABASE_URL=mongodb://mongodb:27017/project-genesis
# REDIS_URL=redis://redis:6379

# Auth (Epic 01) — required by API/worker env validation
JWT_SECRET=change-me-in-local-development-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
